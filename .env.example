# RemnaWave subscription URL. Fetched by postq-vpn-status (not xray-checker
# directly) via /api/subscription-proxy, which backfills REALITY's publicKey
# from the password alias some panels emit — works around xray-checker#188
# silently dropping REALITY servers from monitoring. Remove the proxy hop
# once that's fixed upstream.
SUBSCRIPTION_URL=https://your-remnawave-instance/sub/YOUR_TOKEN_HERE

# Shared secret xray-checker sends (via SUBSCRIPTION_HEADERS) so only it can
# hit /api/subscription-proxy — that route mirrors live server/user
# credentials, so it must not be reachable from the public internet.
SUBSCRIPTION_PROXY_SECRET=change_me_to_a_random_value

# Basic auth credentials for xray-checker's /api/ endpoints
XRAY_CHECKER_USER=admin
XRAY_CHECKER_PASS=change_me_to_a_strong_password

# Internal URL of xray-checker (used server-side by Next.js)
# In Docker: http://xray-checker:2112
# Locally: http://localhost:2112
XRAY_CHECKER_URL=http://xray-checker:2112

# Telegram bot token — used server-side to verify bot availability via getMe
TELEGRAM_BOT_TOKEN=your_bot_token_here

# SQLite file for uptime history (5-minute snapshots, 90-day retention)
# In Docker: /app/data/history.db (mounted as a named volume, see docker-compose.yml)
# Locally: defaults to ./data/history.db if unset
HISTORY_DB_PATH=./data/history.db
